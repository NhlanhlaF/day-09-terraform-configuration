# Local .terraform directories
.terraform/
.terraform.lock.hcl

# State files (store plain-text secrets and resource attributes)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files (often contain passwords and API keys)
*.tfvars
*.tfvars.json

# Plan files (may contain sensitive state data)
*.tfplan
*.tfplan.*

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


